

VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional; leave blank unless a separate assistant API is configured.
VITE_ASSISTANT_API_URL=

# ==================== EXPRESS BACKEND ====================
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
LORIS_BACKEND_SERVICE_ROLE_KEY=your-hybrid-backend-service-role-key

# Generate a fresh 32-byte key encoded as 64 hexadecimal characters.
# Use 'node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"' on powershell to prduce the key. Note changing the key will make old sessions unreadable.
SESSION_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=loris_session
SESSION_TTL_DAYS=14
SESSION_IDLE_TIMEOUT_MINUTES=30


R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BUCKET_PDF=
URL_PDF=
BUCKET_EPUB=
URL_EPUB=
BUCKET_AUDIO=
URL_AUDIO=
BUCKET_VIDEO=
URL_VIDEO=
BUCKET_IMAGE=
URL_IMAGE=

OFFLINE_ACCESS_DAYS=7

RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:5173
