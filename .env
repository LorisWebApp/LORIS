# API path used by the browser. "/api" goes through the Vite dev proxy below. Public value only - never put secrets here.
VITE_API_BASE_URL=/api
# Dev only: where the proxy forwards /api requests (your backend).
VITE_PROXY_TARGET=http://localhost:4000
# Optional: address of the public library. When set, a "View library" button appears in the Platform Manager header.
VITE_LIBRARY_URL=
